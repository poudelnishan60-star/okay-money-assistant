# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real keys.

# Groq (OpenAI-compatible API). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Tried in order when the main model is rate-limited or retired (comma-separated).
LLM_FALLBACK_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# Qwen 3.8 on Groq: "none" = instruct mode (fast, no thinking). Ignored for other models.
LLM_REASONING_EFFORT=none

# Default: SQLite at backend/khalti_ai.db. Set a URL to override (Postgres later).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/khalti_ai

# Seed the demo data automatically when the database is empty (prototype only).
AUTO_SEED=true

# Browsers that may call the API. By default any localhost/127.0.0.1 port is allowed (dev).
# CORS_ORIGINS=https://staging.example.com
# CORS_ORIGIN_REGEX=

# Public website: refuse requests without a visitor session (POST /sessions first).
PUBLIC_MODE=false
SESSION_TTL_DAYS=7

# Rate limits that protect the free Groq quota (per backend process).
RATE_CHAT_PER_MINUTE=6
RATE_CHAT_PER_DAY=80
# Groq free tier: 8,000 tokens/min per model, about 2-3 questions/min each.
RATE_CHAT_GLOBAL_PER_MINUTE=6
RATE_CHAT_GLOBAL_PER_HOUR=300
RATE_SESSIONS_PER_IP_PER_HOUR=10
