# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real keys.

# Groq (OpenAI-compatible API). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Default: SQLite at backend/khalti_ai.db. Set a URL to override (Postgres later).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/khalti_ai

# Seed the demo data automatically when the database is empty (prototype only).
AUTO_SEED=true

# Comma-separated origins allowed to call the API (Flutter web / emulator during dev).
CORS_ORIGINS=http://localhost,http://127.0.0.1
